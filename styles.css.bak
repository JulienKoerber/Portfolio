.portfolio-container {
  display: flex;
  justify-content: center;
  margin: 2rem auto;
  max-width: 500px;
  position: relative;
  z-index: 1;
}

.portfolio-card {
  display: block;
  width: 100%;
  background: var(--clr-surface);
  border-radius: 1.5rem;
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3);
  padding: 2.5rem 2rem;
  text-align: center;
  transition: all 0.4s ease;
  text-decoration: none;
  color: inherit;
  border: 1px solid rgba(99, 102, 241, 0.3);
  position: relative;
  overflow: hidden;
}

.portfolio-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(99, 102, 241, 0.2), transparent);
  transition: left 0.5s;
}

.portfolio-card:hover::before {
  left: 100%;
}

.portfolio-card:hover {
  transform: translateY(-10px) scale(1.02);
  box-shadow: 0 15px 40px rgba(99, 102, 241, 0.4), 0 0 60px rgba(99, 102, 241, 0.2);
  border-color: var(--clr-primary);
}

.portfolio-icon {
  font-size: 3rem;
  margin-bottom: 1rem;
}

@keyframes bounce {
  0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
  40% { transform: translateY(-10px); }
  60% { transform: translateY(-5px); }
}

.portfolio-card h3 {
  margin-bottom: 1rem;
  color: var(--clr-primary);
  font-size: 1.8rem;
  font-weight: 700;
}

.portfolio-card p {
  color: var(--clr-text-dark);
  line-height: 1.6;
  font-size: 1rem;
}

/* Section Stage */
.section--stage {
  /* background: linear-gradient(135deg, #fff8f0, #fff2e8); */
  position: relative;
}

/* .section--stage::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="dots" width="20" height="20" patternUnits="userSpaceOnUse"><circle cx="10" cy="10" r="1" fill="%23ff5a5f" opacity="0.1"/></pattern></defs><rect width="100" height="100" fill="url(%23dots)"/></svg>');
  pointer-events: none;
} */

.stage-container {
  display: flex;
  justify-content: center;
  margin: 2rem auto;
  max-width: 550px;
  position: relative;
  z-index: 1;
}

.stage-card {
  display: block;
  width: 100%;
  background: var(--clr-surface);
  border-radius: 1.5rem;
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3);
  padding: 0;
  text-decoration: none;
  color: inherit;
  transition: all 0.4s ease;
  border: 1px solid rgba(244, 63, 94, 0.3);
  overflow: hidden;
}

.stage-card:hover {
  transform: translateY(-10px) scale(1.02);
  box-shadow: 0 15px 40px rgba(244, 63, 94, 0.4), 0 0 60px rgba(244, 63, 94, 0.2);
  border-color: var(--clr-accent);
}
.stage-icon {
  font-size: 2.5rem;
  margin-bottom: 0.5rem;
}

@keyframes pulse {
  0% { transform: scale(1); }
  50% { transform: scale(1.1); }
  100% { transform: scale(1); }
}

.stage-header h3 {
  margin: 0;
  font-size: 1.6rem;
  font-weight: 600;
}

.stage-content {
  padding: 2rem;
  text-align: center;
  position: relative;
}

.company-logo {
  margin: 1rem 0;
}

.company-logo .project-image {
  max-width: 180px;
  height: auto;
  filter: drop-shadow(0 4px 8px rgba(0,0,0,0.1));
  transition: transform 0.3s ease;
}

.stage-card:hover .project-image {
  transform: scale(1.05);
}

.stage-description {
  color: var(--clr-text-dark);
  line-height: 1.6;
  margin: 1.5rem 0;
  font-size: 1rem;
}

.stage-badge {
  position: absolute;
  top: 1rem;
  right: 1rem;
  background: var(--clr-accent);
  color: white;
  padding: 0.5rem 1rem;
  border-radius: 2rem;
  font-size: 0.9rem;
  font-weight: 600;
  box-shadow: 0 2px 8px rgba(255, 90, 95, 0.3);
}

/* Responsive pour les nouvelles sections */
@media (max-width: 768px) {
  .portfolio-container,
  .stage-container {
    max-width: 90%;
    margin: 1rem auto;
  }
  
  .portfolio-card,
  .stage-card {
    padding: 1.5rem;
  }
  
  .stage-header {
    padding: 1.5rem;
  }
  
  .stage-content {
    padding: 1.5rem;
  }
  
  .portfolio-icon,
  .stage-icon {
    font-size: 2rem;
  }
}

/* ================================================== */
/* STYLES POUR LES SECTIONS PROJETS BUT 1 ET BUT 2 */
/* ================================================== */

/* Section Projets BUT 2 */
.section--projects-but2 {
  /* background: linear-gradient(135deg, #f0f8ff, #e6f3ff); */
  position: relative;
}

