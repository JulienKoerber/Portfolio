:root {
  --clr-primary: #6366f1;
  --clr-secondary: #1e1e2e;
  --clr-accent: #f43f5e;
  --clr-text: #e5e7eb;
  --clr-text-dark: #9ca3af;
  --clr-surface: #27293d;
  --clr-surface-light: #2f3349;
  --font-base: 'Montserrat', sans-serif;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: var(--font-base);
  color: var(--clr-text);
  background-color: var(--clr-secondary);
  scroll-behavior: smooth;
  padding-top: 4rem; /* Pour compenser la nav fixe */
  background-image: 
    radial-gradient(at 0% 0%, rgba(99, 102, 241, 0.1) 0, transparent 50%),
    radial-gradient(at 100% 100%, rgba(244, 63, 94, 0.1) 0, transparent 50%);
}

/* Titres */
.h3 {
  font-size: 2rem;
  margin-bottom: 1rem;
  color: var(--clr-primary);
}

/* Navigation */
.nav {
  position: fixed;
  width: 100%;
  top: 0;
  left: 0;
  background: rgba(30, 30, 46, 0.9);
  backdrop-filter: blur(10px);
  border-bottom: 1px solid rgba(99, 102, 241, 0.2);
  z-index: 1000;
}
.nav__list {
  display: flex;
  justify-content: center;
  list-style: none;
  padding: 1rem;
}
.nav__link {
  margin: 0 1rem;
  text-decoration: none;
  font-weight: 700;
  color: var(--clr-text);
  transition: all 0.3s;
  position: relative;
}
.nav__link::after {
  content: '';
  position: absolute;
  bottom: -5px;
  left: 0;
  width: 0;
  height: 2px;
  background: var(--clr-primary);
  transition: width 0.3s;
}
.nav__link:hover {
  color: var(--clr-primary);
}
.nav__link:hover::after {
  width: 100%;
}

/* Sections */
.section {
  padding: 5rem 2rem;
}

/* Intro - Version avec photo */
.section--intro {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #1e1e2e 0%, #2d1b4e 50%, #1e1e2e 100%);
  color: white;
  position: relative;
  padding: 2rem;
  overflow: hidden;
}
.section--intro::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: 
    radial-gradient(circle at 20% 30%, rgba(99, 102, 241, 0.15) 0%, transparent 40%),
    radial-gradient(circle at 80% 70%, rgba(244, 63, 94, 0.15) 0%, transparent 40%);
  pointer-events: none;
}

.intro__container {
  display: grid;
  grid-template-columns: 1fr 1.2fr;
  gap: 4rem;
  max-width: 1200px;
  width: 100%;
  align-items: center;
}

/* Partie gauche - Photo et nom */
.intro__left {
  display: flex;
  flex-direction: column  ;
  align-items: center;
  text-align: center;
}

.intro__photo {
  margin-bottom: 2rem;
  position: relative;
}

.intro__image {
  width: 250px;
  height: 250px;
  border-radius: 50%;
  object-fit: cover;
  border: 4px solid rgba(99, 102, 241, 0.5);
  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.3), 0 0 40px rgba(99, 102, 241, 0.3);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.intro__image:hover {
  transform: scale(1.05);
  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.4), 0 0 60px rgba(99, 102, 241, 0.5);
}

.intro__name {
  font-size: 2.5rem;
  font-weight: 800;
  margin: 0;
  line-height: 1.1;
}

/* Partie droite - Contenu */
.intro__right {
  display: flex;
  flex-direction: column;
  justify-content: center;
  text-align: left;
}

.intro__greeting {
  font-size: 1.3rem;
  margin-bottom: 1rem;
  opacity: 0.9;
  font-weight: 500;
}

.intro__role {
  font-size: 2.2rem;
  font-weight: 600;
  margin-bottom: 0.5rem;
  opacity: 0.95;
  line-height: 1.2;
}

.intro__specialty {
  font-size: 1.1rem;
  margin-bottom: 2rem;
  padding: 0.5rem 1.5rem;
  background: rgba(99, 102, 241, 0.2);
  border-radius: 2rem;
  display: inline-block;
  border: 1px solid rgba(99, 102, 241, 0.4);
  width: fit-content;
  box-shadow: 0 0 20px rgba(99, 102, 241, 0.2);
}

.intro__description {
  font-size: 1.2rem;
  line-height: 1.6;
  margin-bottom: 2.5rem;
  opacity: 0.9;
}

.intro__cta {
  margin-top: 1rem;
}

.intro__btn {
  display: inline-block;
  padding: 1rem 2.5rem;
  background: linear-gradient(135deg, var(--clr-primary), #8b5cf6);
  color: white;
  text-decoration: none;
  border-radius: 3rem;
  font-weight: 700;
  font-size: 1.1rem;
  transition: all 0.3s ease;
  box-shadow: 0 4px 15px rgba(99, 102, 241, 0.4);
  border: 1px solid rgba(99, 102, 241, 0.3);
}

.intro__btn:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 25px rgba(99, 102, 241, 0.6), 0 0 30px rgba(99, 102, 241, 0.3);
  background: linear-gradient(135deg, #8b5cf6, var(--clr-primary));
}

.highlight {
  background: linear-gradient(135deg, #a78bfa, #ec4899);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  filter: drop-shadow(0 0 20px rgba(167, 139, 250, 0.3));
}

/* Responsive pour intro avec photo */
@media (max-width: 768px) {
  .intro__container {
    grid-template-columns: 1fr;
    gap: 2rem;
    text-align: center;
  }
  
  .intro__right {
    text-align: center;
  }
  
  .intro__image {
    width: 200px;
    height: 200px;
  }
  
  .intro__name {
    font-size: 2rem;
  }
  
  .intro__role {
    font-size: 1.6rem;
  }
  
  .intro__description {
    font-size: 1.1rem;
  }
  
  .intro__specialty {
    margin: 0 auto 2rem auto;
  }
}

@media (max-width: 480px) {
  .section--intro {
    padding: 1rem;
  }
  
  .intro__image {
    width: 150px;
    height: 150px;
  }
  
  .intro__name {
    font-size: 1.8rem;
  }
  
  .intro__role {
    font-size: 1.4rem;
  }
}

/* Section Compétences par UE */
.section--skills {
  /* background: linear-gradient(135deg, #f0f4ff, #e1eaff); */
  position: relative;
}

/* .section--skills::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="skills-pattern" width="30" height="30" patternUnits="userSpaceOnUse"><circle cx="15" cy="15" r="8" fill="none" stroke="%232c3e50" stroke-width="0.5" opacity="0.1"/><circle cx="15" cy="15" r="3" fill="%232c3e50" opacity="0.05"/></pattern></defs><rect width="100" height="100" fill="url(%23skills-pattern)"/></svg>');
  pointer-events: none;
} */

.section--skills2 {
  /* background-color: rgb(162, 162, 253); */
}
.section__title {
  text-align: center;
  font-size: 2.5rem;
  margin-bottom: 2rem;
  color: var(--clr-primary);
  text-shadow: 0 0 30px rgba(99, 102, 241, 0.3);
}
.skills-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 2rem;
  width: 90%;
  max-width: 1200px;
  margin: auto;
}

/* On place la 3ème carte sur la 2ème ligne, centrée et pleine largeur */
.skills-grid .skill-card:nth-child(3) {
  grid-row: auto;        /* commence à la ligne 2 */
  grid-column: auto; /* occupe toutes les colonnes */
  justify-self: center;/* centre la carte si elle ne remplit pas toute la largeur */
}

.skill-card {
  display: block;       /* inline → block */
  width: 100%;          /* pour remplir la colonne du grid */
  /* votre code existant */
  background: var(--clr-surface);
  border-radius: 1rem;
  box-shadow: 0 4px 10px rgba(0,0,0,0.3);
  padding: 2rem;
  text-align: center;
  transition: all 0.3s;
  text-decoration: none;
  color: inherit;
  border: 1px solid rgba(99, 102, 241, 0.2);
}

.skill-card:hover {
  transform: translateY(-10px);
  box-shadow: 0 8px 20px rgba(99, 102, 241, 0.4), 0 0 40px rgba(99, 102, 241, 0.2);
  border-color: var(--clr-primary);
}
.skill-card h3 {
  margin-bottom: 1rem;
  color: var(--clr-primary);
  font-size: 1.5rem;
}
.skill-card p {
  line-height: 1.5;
  color: var(--clr-text-dark);
}

.cards--skills {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 2rem;
}


/* Footer */
.footer {
  text-align: center;
  padding: 2rem 0;
  font-size: 0.9rem;
  background: linear-gradient(135deg, #1a1a2e, #2d1b4e);
  color: var(--clr-text);
  border-top: 1px solid rgba(99, 102, 241, 0.2);
}
.footer p {
  margin: 0;
}

/* ----------------------------------------- */
/* Styles spécifiques à la page projet1.html */
/* ----------------------------------------- */

/* Titre principal de la page projet */
.page-main-title {
  text-align: center;
  font-size: 3.2rem;
  margin: 2rem 0;
  color: var(--clr-primary);
  text-shadow: 0 0 30px rgba(99, 102, 241, 0.4);
}

/* Bannière projet */
.project-header {
  width: 100%;
  overflow: hidden;
}
.project-banner {
  width: 100%;
  height: auto;
  display: block;
  object-fit: cover;
}

/* Titre secondaire (nom du projet) */
.project-title {
  text-align: center;
  font-size: 2.5rem;
  margin: 1rem 0 2rem;
  color: var(--clr-primary);
  text-shadow: 0 0 25px rgba(99, 102, 241, 0.3);
}

/* Contenu projet en grille responsive */
.project-content {
  display: grid;
  grid-template-columns: repeat(2, 1fr); /* Deux colonnes égales */
  gap: 3rem;
  width: 100%;
  padding: 0 2rem;
  box-sizing: border-box;
  margin: 0 auto;
  max-width: 1600px; /* Largeur max étendue */
}

/* Bloc texte amélioré */
.text-block {
  background: var(--clr-surface);
  border-radius: 1rem;
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
  padding: 2.5rem;
  line-height: 1.8;
  font-size: 1.1rem;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  border: 1px solid rgba(99, 102, 241, 0.2);
}
.text-block:hover {
  transform: translateY(-5px);
  box-shadow: 0 12px 30px rgba(99, 102, 241, 0.3), 0 0 40px rgba(99, 102, 241, 0.1);
  border-color: var(--clr-primary);
}
.text-block h2,
.text-block h3 {
  color: var(--clr-primary);
  margin-bottom: 1rem;
  font-size: 1.8rem;
}
.text-block p {
  color: var(--clr-text-dark);
}

/* Listes stylisées */
.text-block ul {
  padding-left: 1.5rem;
  margin-top: 1rem;
}
.text-block ul li {
  margin-bottom: 0.75rem;
  line-height: 1.6;
  list-style-type: disc;
  color: var(--clr-text-dark);
}
.text-block ul ul {
  margin-top: 0.25rem;
  list-style-type: circle;
}

/* Ajustements mobiles */
@media (max-width: 600px) {
  .page-main-title {
    font-size: 2.2rem;
  }

  .project-title {
    font-size: 1.8rem;
  }

  .text-block {
    padding: 1.5rem;
    font-size: 1rem;
  }

  .text-block h2 {
    font-size: 1.5rem;
  }

  .project-content {
    padding: 2rem 1rem;
  }
}
/* Bouton de téléchargement */
.download-link {
  text-decoration: none;
  color: var(--clr-primary);
  font-weight: 600;
  transition: color 0.3s;
}

.download-link:hover {
  color: var(--clr-accent);
}

/* Styles pour les images de projet */
.image-container {
  text-align: center;
  margin-top: 3rem;
  margin-bottom: 2rem;
}








.return-button {
  position: absolute;
  top: 1.5rem;
  left: 1.5rem;
  background: var(--clr-surface);
  padding: 0.75rem 1.25rem;
  border-radius: 1rem;
  box-shadow: 0 4px 10px rgba(0,0,0,0.3);
  font-weight: 600;
  z-index: 1100;
  transition: all 0.3s;
  border: 1px solid rgba(99, 102, 241, 0.3);
}

.return-button a {
  text-decoration: none;
  color: var(--clr-primary);
}

.return-button:hover {
  transform: translateY(-3px);
  box-shadow: 0 6px 15px rgba(99, 102, 241, 0.4), 0 0 30px rgba(99, 102, 241, 0.2);
  border-color: var(--clr-primary);
}

.slider-wrapper {
  position: relative;
  display: flex;
  align-items: center;
  gap: 1rem;
  max-width: 100%;
  overflow: hidden;
}

.scroll-container {
  display: flex;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
  gap: 1rem;
  padding: 1rem 0;
}

.scroll-container::-webkit-scrollbar {
  display: none; /* Chrome/Safari */
}

.scroll-btn {
  background: linear-gradient(135deg, var(--clr-primary), #8b5cf6);
  color: white;
  border: none;
  font-size: 2rem;
  padding: 0.5rem 1rem;
  cursor: pointer;
  border-radius: 50%;
  transition: all 0.3s;
  box-shadow: 0 4px 15px rgba(99, 102, 241, 0.3);
  border: 1px solid rgba(99, 102, 241, 0.3);
}

.scroll-btn:hover {
  background: linear-gradient(135deg, #8b5cf6, var(--clr-accent));
  box-shadow: 0 6px 20px rgba(99, 102, 241, 0.5), 0 0 30px rgba(99, 102, 241, 0.3);
  transform: scale(1.1);
}

.skill-card {
  min-width: 280px;
  flex-shrink: 0;
}
/* Grille deux colonnes pour UE X.1 */
.skills-two-cols {
  display: flex;
  gap: 2rem;
  justify-content: center;
  flex-wrap: wrap;
  margin-top: 2rem;
  width: 100%;
}

.skills-two-cols .skill-card {
  flex: 1 1 400px;
  max-width: 600px;
  background: var(--clr-surface);
  border-radius: 1rem;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
  padding: 2rem;
  transition: all 0.3s;
  color: var(--clr-text);
  text-align: left;
  border: 1px solid rgba(99, 102, 241, 0.2);
}

.skills-two-cols .skill-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 8px 20px rgba(99, 102, 241, 0.4), 0 0 40px rgba(99, 102, 241, 0.2);
  border-color: var(--clr-primary);
}

.skills-two-cols .skill-card h3 {
  margin-bottom: 1rem;
  color: var(--clr-primary);
  font-size: 1.5rem;
}

.skills-two-cols .skill-card ul {
  list-style-type: disc;
  padding-left: 1.5rem;
}

.skills-two-cols .skill-card li {
  margin-bottom: 0.75rem;
  line-height: 1.6;
}

/* Styles pour les onglets rétractables UE */
.ue-tabs-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 2rem;
  position: relative;
  z-index: 1;
}

.ue-tab {
  margin-bottom: 1.5rem;
  border-radius: 1.5rem;
  overflow: hidden;
  background: var(--clr-surface);
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3);
  border: 1px solid rgba(99, 102, 241, 0.3);
  transition: all 0.4s ease;
}

.ue-tab:hover {
  transform: translateY(-5px);
  box-shadow: 0 12px 35px rgba(99, 102, 241, 0.4), 0 0 50px rgba(99, 102, 241, 0.2);
  border-color: var(--clr-primary);
}

.ue-tab-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 2rem 2.5rem;
  background: linear-gradient(135deg, var(--clr-primary), #8b5cf6);
  color: white;
  cursor: pointer;
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.ue-tab-header::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
  transition: left 0.5s ease;
}

.ue-tab-header:hover::before {
  left: 100%;
}

.ue-tab-header:hover {
  background: linear-gradient(135deg, #1e2a8f, var(--clr-primary));
}

.ue-tab-header h3 {
  margin: 0;
  font-size: 1.4rem;
  font-weight: 700;
  text-shadow: 0 2px 4px rgba(0,0,0,0.2);
}

.tab-icon {
  font-size: 1.8rem;
  font-weight: bold;
  transition: all 0.3s ease;
  background: rgba(255,255,255,0.2);
  width: 40px;
  height: 40px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(10px);
}

.tab-icon.active {
  transform: rotate(45deg);
  background: rgba(255,255,255,0.3);
}

.ue-tab-content {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.4s ease-out;
  background: linear-gradient(135deg, #ffffff, #f8faff);
}

.ue-tab-content.active {
  max-height: 1000px;
  transition: max-height 0.6s ease-in;
}

.ue-tab-content .skills-two-cols {
  padding: 2.5rem;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2rem;
  min-height: 400px;
  align-items: start;
}

/* Ajustements pour les skill-cards dans les onglets */
.ue-tab-content .skill-card {
  background: white;
  border-radius: 1.2rem;
  box-shadow: 0 6px 20px rgba(44, 62, 80, 0.1);
  padding: 2rem;
  transition: all 0.3s ease;
  border: 1px solid rgba(52, 152, 219, 0.1);
  height: 100%;
  display: flex;
  flex-direction: column;
}

.ue-tab-content .skill-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 25px rgba(44, 62, 80, 0.15);
  border-color: rgba(52, 152, 219, 0.3);
}

.ue-tab-content .skill-card h3 {
  color: var(--clr-primary);
  font-size: 1.3rem;
  font-weight: 700;
  margin-bottom: 1.2rem;
  text-align: center;
  padding-bottom: 0.8rem;
  border-bottom: 2px solid rgba(52, 152, 219, 0.2);
}

.ue-tab-content .skill-card ul {
  list-style: none;
  padding: 0;
  flex-grow: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.ue-tab-content .skill-card li {
  padding: 0.6rem 0;
  border-bottom: 1px solid #f0f4ff;
  transition: all 0.2s ease;
  position: relative;
  padding-left: 1.5rem;
}

.ue-tab-content .skill-card li:before {
  content: '✓';
  position: absolute;
  left: 0;
  color: var(--clr-accent);
  font-weight: bold;
  font-size: 1.1rem;
}

.ue-tab-content .skill-card li:hover {
  background: rgba(52, 152, 219, 0.05);
  padding-left: 2rem;
}

.ue-tab-content .skill-card li:last-child {
  border-bottom: none;
}

/* ================================================== */
/* STYLES AMÉLIORÉS POUR PORTFOLIO 1ÈRE ANNÉE ET STAGE */
/* ================================================== */

/* Section Portfolio et Stage côte à côte */
.section--portfolio-stage {
  /* background: linear-gradient(135deg, #f8faff, #e8f0ff); */
  position: relative;
  padding: 4rem 0;
}

/* .section--portfolio-stage::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="grid-combined" width="10" height="10" patternUnits="userSpaceOnUse"><path d="M 10 0 L 0 0 0 10" fill="none" stroke="%23e0e8ff" stroke-width="0.5"/></pattern></defs><rect width="100" height="100" fill="url(%23grid-combined)"/></svg>');
  opacity: 0.3;
  pointer-events: none;
} */

.portfolio-stage-container {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3rem;
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 2rem;
  position: relative;
  z-index: 1;
}

.portfolio-section,
.stage-section {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.portfolio-section .section__title,
.stage-section .section__title {
  text-align: center;
  font-size: 2rem;
  margin-bottom: 2rem;
  color: var(--clr-primary);
}

/* Responsive pour Portfolio et Stage côte à côte */
@media (max-width: 768px) {
  .portfolio-stage-container {
    grid-template-columns: 1fr;
    gap: 2rem;
    padding: 0 1rem;
  }
  
  .portfolio-section .section__title,
  .stage-section .section__title {
    font-size: 1.8rem;
    margin-bottom: 1.5rem;
  }
}

@media (max-width: 480px) {
  .section--portfolio-stage {
    padding: 2rem 0;
  }
  
  .portfolio-stage-container {
    gap: 1.5rem;
  }
  
  .portfolio-section .section__title,
  .stage-section .section__title {
    font-size: 1.6rem;
  }
}

/* Section Portfolio 1ère année */
.section--portfolio {
  /* background: linear-gradient(135deg, #f8faff, #e8f0ff); */
  position: relative;
}

/* .section--portfolio::before {
  content: '';
