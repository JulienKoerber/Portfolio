/* Section Projets BUT 1 */
.section--projects-but1 {
  /* background: linear-gradient(135deg, #fff5f0, #ffe8e0); */
  position: relative;
}

/* .section--projects-but1::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="triangles" width="20" height="20" patternUnits="userSpaceOnUse"><path d="M10,2 L18,16 L2,16 Z" fill="none" stroke="%23ff5a5f" stroke-width="0.5" opacity="0.1"/></pattern></defs><rect width="100" height="100" fill="url(%23triangles)"/></svg>');
  pointer-events: none;
} */

/* Container des projets */
.projects-container {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 2rem;
  max-width: 1200px;
  margin: 2rem auto;
  padding: 0 2rem;
  position: relative;
  z-index: 1;
}

/* Cartes de projet */
.project-card {
  display: block;
  background: var(--clr-surface);
  border-radius: 1.5rem;
  box-shadow: 0 8px 25px rgba(0,0,0,0.3);
  text-decoration: none;
  color: inherit;
  transition: all 0.4s ease;
  border: 1px solid rgba(99, 102, 241, 0.2);
  overflow: hidden;
  position: relative;
}

.project-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(99, 102, 241, 0.2), transparent);
  transition: left 0.6s;
  z-index: 1;
}

.project-card:hover::before {
  left: 100%;
}

.project-card:hover {
  transform: translateY(-12px) scale(1.03);
  box-shadow: 0 20px 40px rgba(99, 102, 241, 0.4), 0 0 60px rgba(99, 102, 241, 0.2);
  border-color: var(--clr-primary);
}

/* Header des cartes de projet BUT 2 */
.section--projects-but2 .project-card:hover {
  border-color: var(--clr-primary);
  box-shadow: 0 20px 40px rgba(99, 102, 241, 0.4), 0 0 60px rgba(99, 102, 241, 0.2);
}

.section--projects-but2 .project-header {
  background: linear-gradient(135deg, var(--clr-primary), #8b5cf6);
  color: white;
  padding: 1.5rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: relative;
}

/* Header des cartes de projet BUT 1 */
.section--projects-but1 .project-card:hover {
  border-color: var(--clr-accent);
  box-shadow: 0 20px 40px rgba(244, 63, 94, 0.4), 0 0 60px rgba(244, 63, 94, 0.2);
}

.section--projects-but1 .project-header {
  background: linear-gradient(135deg, #f43f5e, #ec4899);
  color: white;
  padding: 1.5rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: relative;
}

.project-header::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 15px;
  background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 15"><path d="M0,0 Q50,15 100,0 L100,15 L0,15 Z" fill="white"/></svg>');
}

.project-icon {
  font-size: 2rem;
}

@keyframes float {
  0%, 100% { transform: translateY(0px); }
  50% { transform: translateY(-8px); }
}

.project-number {
  font-size: 1rem;
  font-weight: 700;
  background: rgba(255,255,255,0.2);
  padding: 0.5rem 1rem;
  border-radius: 2rem;
  backdrop-filter: blur(10px);
}

/* Contenu des cartes */
.project-content {
  padding: 2rem;
  position: relative;
  z-index: 2;
}

.project-content h3 {
  margin: 0 0 1rem 0;
  font-size: 1.4rem;
  font-weight: 600;
  color: var(--clr-text);
  line-height: 1.3;
}

.project-content p {
  color: #666;
  line-height: 1.6;
  margin-bottom: 1.5rem;
  font-size: 0.95rem;
}

/* Tags des projets */
.project-tags {
  display: flex;
  gap: 0.5rem;
  flex-wrap: wrap;
}

.project-tags span {
  background: var(--clr-secondary);
  color: var(--clr-primary);
  padding: 0.3rem 0.8rem;
  border-radius: 1rem;
  font-size: 0.8rem;
  font-weight: 500;
  border: 1px solid rgba(42, 62, 177, 0.2);
  transition: all 0.3s ease;
}

.section--projects-but1 .project-tags span {
  color: var(--clr-accent);
  border-color: rgba(255, 90, 95, 0.2);
}

.project-tags span:hover {
  transform: scale(1.05);
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

/* Responsive pour les projets */
@media (max-width: 768px) {
  .projects-container {
    grid-template-columns: 1fr;
    gap: 1.5rem;
    padding: 0 1rem;
  }
  
  .project-card {
    margin: 0;
  }
  
  .project-header {
    padding: 1.2rem !important;
  }
  
  .project-content {
    padding: 1.5rem;
  }
  
  .project-icon {
    font-size: 1.5rem;
  }
  
  .project-number {
    font-size: 0.9rem;
    padding: 0.4rem 0.8rem;
  }
}

@media (max-width: 480px) {
  .project-header {
    flex-direction: column;
    gap: 1rem;
    text-align: center;
  }
  
  .project-content h3 {
    font-size: 1.2rem;
  }
}
